{
  "name": "@foundryui/cli",
  "version": "0.2.0",
  "description": "The ongoing, in-project Foundry CLI. Scaffolds artifacts (components today, more artifact types later) into an existing Foundry project. Not to be confused with create-react-foundry, which scaffolds the project itself.",
  "keywords": [
    "react",
    "design-system",
    "component-generator",
    "cli",
    "scaffolding",
    "typescript",
    "storybook",
    "accessibility"
  ],
  "license": "Apache-2.0",
  "author": "Polina Tymchenko <polinatymchenkodev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/PolinaTymchenko/foundry.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/PolinaTymchenko/foundry/tree/main/packages/cli#readme",
  "bugs": "https://github.com/PolinaTymchenko/foundry/issues",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "foundry": "./dist/index.js"
  },
  "files": ["dist", "templates"],
  "scripts": {
    "build": "tsup && chmod +x dist/index.js",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "@foundryui/generator-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
