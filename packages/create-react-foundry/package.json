{
  "name": "create-react-foundry",
  "version": "0.4.0",
  "description": "Scaffold a new Foundry-based project. Run with: npm create react-foundry",
  "keywords": [
    "react",
    "design-system",
    "component-library",
    "scaffolding",
    "create-react-app",
    "vite",
    "typescript",
    "storybook",
    "cli"
  ],
  "license": "Apache-2.0",
  "author": "Polina Tymchenko <polinatymchenkodev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/PolinaTymchenko/foundry.git",
    "directory": "packages/create-react-foundry"
  },
  "homepage": "https://github.com/PolinaTymchenko/foundry/tree/main/packages/create-react-foundry#readme",
  "bugs": "https://github.com/PolinaTymchenko/foundry/issues",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "create-react-foundry": "./dist/index.js"
  },
  "files": ["dist", "templates"],
  "scripts": {
    "build": "tsup && chmod +x dist/index.js",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "@foundryui/generator-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
