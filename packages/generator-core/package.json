{
  "name": "@foundryui/generator-core",
  "version": "0.1.2",
  "description": "Framework-agnostic template rendering and prompt orchestration engine shared by every Foundry generator.",
  "keywords": [
    "scaffolding",
    "code-generation",
    "generator",
    "cli",
    "template-engine",
    "typescript"
  ],
  "license": "Apache-2.0",
  "author": "Polina Tymchenko <polinatymchenkodev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/PolinaTymchenko/foundry.git",
    "directory": "packages/generator-core"
  },
  "homepage": "https://github.com/PolinaTymchenko/foundry/tree/main/packages/generator-core#readme",
  "bugs": "https://github.com/PolinaTymchenko/foundry/issues",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
